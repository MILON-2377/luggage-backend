<!doctype html>
<html lang="en">
  <body style="font-family: Arial, sans-serif; color: #1a1a1a; line-height: 1.5;">
    <p>A password reset was requested for your {{ app_name }} account.</p>
    <p>Use the button below to reset your password.</p>
    <p>
      <a href="{{ reset_url }}"
         style="display: inline-block; padding: 10px 18px; background: #1d4ed8;
                color: #ffffff; text-decoration: none; border-radius: 4px;">
        Reset password
      </a>
    </p>
    <p>If the button does not work, copy this link into your browser:<br>
      <a href="{{ reset_url }}">{{ reset_url }}</a>
    </p>
    <p>
      This link expires in {{ expires_in_minutes }} minutes and was sent to
      {{ recipient_email }}.
    </p>
    <p>
      If you did not request a password reset, you can ignore this email.
      Your password will remain unchanged.
    </p>
  </body>
</html>